# ==========================================
# ABA Data Collection - Frontend Environment
# ==========================================
# For Vite, env vars must start with VITE_
# Copy to .env and fill in your values

# Backend API URL (required for production)
VITE_API_URL=http://localhost:8000

# For production (Vercel), set to your Render backend URL:
# VITE_API_URL=https://aba-data-backend.onrender.com
